{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "short_name": "Juntgraphy",
  "version": "0.1",
  "author": "준토폴리오",
  "description": "__MSG_appDesc__",
  "default_locale": "ko",
  "permissions": ["contextMenus", "storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "__MSG_appName__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html"
  }
}
